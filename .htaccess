Options -Indexes -MultiViews
RewriteEngine On

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "DENY"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "camera=(self), geolocation=(self), microphone=()"
</IfModule>

<FilesMatch "^(?:\.env|error_log|composer\.(?:json|lock)|compose\.yaml|Dockerfile|check_tables\.php|criar_tabelas\.php|debug_funcao\.php|diagnostic_facial\.php|diagnostico\.php|scratch\.php|setup_models\.php|verificar_modelos\.php|.*(?:backup|bak|old|15-05).*php)$">
    Require all denied
</FilesMatch>

# Compatibilidade com navegadores que solicitam favicon.ico automaticamente.
RewriteRule ^favicon\.ico$ assets/favicon.svg [END]

# O front controller não é uma rota pública. Rewrites internos não possuem
# esse caminho em THE_REQUEST e continuam funcionando normalmente.
RewriteCond %{THE_REQUEST} \s/+front-controller\.php(?:[?\s]) [NC]
RewriteRule ^ - [R=404,L]

# Requisições explícitas a PHP passam pelo front controller, que gera a URL
# canônica usando apenas REQUEST_URI e nunca o caminho físico do servidor.
RewriteCond %{THE_REQUEST} \s/+[^?\ ]+\.php(?:[?\s]) [NC]
RewriteRule ^ front-controller.php [END,QSA]

# Arquivos estáticos e diretórios reais continuam sendo servidos pelo Apache.
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [END]

# Todas as demais URLs são resolvidas pelo front controller.
RewriteRule ^ front-controller.php [END,QSA]
