# Proteção de diretórios
Options -Indexes

# Proteger arquivos sensíveis (sintaxe Apache 2.4+)
<FilesMatch "^(config|auth|csrf|database)\.php$">
    Require all denied
</FilesMatch>

# Prevenir acesso direto a backups
<FilesMatch "\.(sql|bak|zip|tar|gz)$">
    Require all denied
</FilesMatch>

# Redirecionar para HTTPS apenas fora do localhost
RewriteEngine On
RewriteCond %{HTTPS} off
RewriteCond %{HTTP_HOST} !^(localhost|127\.0\.0\.1)(:[0-9]+)?$ [NC]
RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]
