server {
    listen 80;
    server_name ponto.exemplo.com;

    root /var/www/projects/public/sistema-pontos;
    index index.php index.html;

    # Troque pelo limite desejado para fotos e anexos.
    client_max_body_size 5m;

    # Impede o download de configuracoes, metadados e backups.
    location ~ /\. {
        deny all;
    }

    location ~* \.(?:sql|sql\.gz)$ {
        deny all;
    }

    # Arquivos existentes sao servidos diretamente. Uma rota como
    # /modules/usuarios tenta /modules/usuarios.php e, se nao existir,
    # devolve 404 sem encaminhar para um script arbitrario.
    location / {
        try_files $uri $uri/ $uri.php =404;
    }

    # Nunca execute PHP enviado para a pasta publica de uploads.
    location ~* ^/uploads/.*\.php$ {
        deny all;
    }

    location ~ \.php$ {
        try_files $uri =404;
        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME $document_root$fastcgi_script_name;
        fastcgi_param HTTP_PROXY "";

        # Ajuste para o socket ou host do PHP-FPM instalado.
        fastcgi_pass unix:/run/php/php8.2-fpm.sock;
    }
}
