# Proteção de diretórios
Options -Indexes

# Proteger arquivos sensíveis
<FilesMatch "^(config|auth|csrf|database)\.php$">
    Order allow,deny
    Deny from all
</FilesMatch>

# Prevenir acesso direto a backups
<FilesMatch "\.(sql|bak|zip|tar|gz)$">
    Order allow,deny
    Deny from all
</FilesMatch>

# Redirecionar para HTTPS fora do localhost.
# Em XAMPP/local, forcar HTTPS quebra o carregamento de assets/modelos.
RewriteEngine On
RewriteCond %{HTTPS} off
RewriteCond %{HTTP_HOST} !^(localhost|127\.0\.0\.1)(:[0-9]+)?$ [NC]
RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]
