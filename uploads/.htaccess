Options -Indexes

# Uploads nunca devem ser interpretados como código pelo servidor web.
<FilesMatch "\.(?:php[0-9]?|phtml|phar|cgi|pl|py|sh)$">
    Require all denied
</FilesMatch>

RemoveHandler .php .phtml .phar
RemoveType .php .phtml .phar
<IfModule mod_php.c>
    php_flag engine off
</IfModule>
<IfModule mod_php8.c>
    php_flag engine off
</IfModule>
