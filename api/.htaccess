# api/.htaccess - Regras de reescrita para API
RewriteEngine On

# CORS é aplicado de forma restrita por api/config.php.

# A API usa o mesmo front controller da aplicação. REQUEST_URI é preservada,
# permitindo resolver /api/recurso sem expor o arquivo recurso.php.
RewriteCond %{THE_REQUEST} \s/+[^?\ ]+\.php(?:[?\s]) [NC]
RewriteRule ^ ../front-controller.php [END,QSA]

RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [END]

RewriteRule ^ ../front-controller.php [END,QSA]

# Forçar JSON como padrão
AddType application/json .json
